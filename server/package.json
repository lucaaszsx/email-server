{
    "$schema": "https://json.schemastore.org/package.json",
    "name": "email-server",
    "description": "A email server that receives webhooks from Cloudflare Email Routing.",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "keywords": [
        "email-server",
        "cloudflare",
        "routing",
        "webhooks",
        "apis",
        "server",
        "express"
    ],
    "license": "MIT",
    "author": {
        "name": "Lucas",
        "email": "jlucasmelob558@gmail.com",
        "url": "https://github.com/lucaaszsx"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/lucaaszsx/email-server.git"
    },
    "bugs": {
        "url": "https://github.com/lucaaszsx/email-server/issues"
    },
    "homepage": "https://github.com/lucaaszsx/email-server#README",
    "scripts": {
        "dev": "tsx src/index.ts",
        "dev:watch": "tsx watch src/index.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node .",
        "clean": "rimraf dist",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "type-check": "tsc --noEmit"
    },
    "packageManager": "pnpm@11.9.0",
    "dependencies": {
        "bcrypt": "^6.0.0",
        "chalk": "^6.0.0",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "http-status-codes": "^2.3.0",
        "jsonwebtoken": "^9.0.3",
        "postgres": "^3.4.9",
        "reflect-metadata": "^0.2.2",
        "tsyringe": "^4.10.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.6",
        "@types/node": "^26.0.1",
        "eslint": "^10.6.0",
        "eslint-config-prettier": "^10.1.8",
        "prettier": "^3.8.5",
        "rimraf": "^6.1.3",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.0"
    }
}
